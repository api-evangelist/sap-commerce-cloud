{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Price",
  "title": "Price",
  "type": "object",
  "properties": {
    "currencyIso": {
      "type": "string",
      "description": "ISO 4217 currency code"
    },
    "value": {
      "type": "number",
      "format": "double",
      "description": "Price value"
    },
    "formattedValue": {
      "type": "string",
      "description": "Formatted price string"
    },
    "priceType": {
      "type": "string",
      "enum": [
        "BUY",
        "FROM"
      ],
      "description": "Price type"
    }
  }
}