{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Classification",
  "title": "Classification",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Classification code"
    },
    "name": {
      "type": "string",
      "description": "Classification name"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "featureValues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}