{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAP Commerce Cloud Admin Addresses Customers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{tenant}.{region}.commercecloud.sap/authorizationserver/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Customers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SAP Commerce Cloud Search customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.{region}.commercecloud.sap/customers/search",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Search query (name, email, or customer ID)"
              },
              {
                "name": "baseSite",
                "value": "",
                "type": "query",
                "description": "Base site identifier"
              },
              {
                "name": "currentPage",
                "value": "",
                "type": "query",
                "description": "Current page number (zero-based)"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Search for customers by name, email, or customer ID. Used by customer service agents to find customer accounts."
        },
        {
          "info": {
            "name": "SAP Commerce Cloud Get customer 360 view",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.{region}.commercecloud.sap/customers/:customerId",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "Customer unique identifier"
              },
              {
                "name": "baseSite",
                "value": "",
                "type": "query",
                "description": "Base site identifier"
              }
            ]
          },
          "docs": "Retrieve a comprehensive 360-degree view of a customer including profile information, recent orders, active carts, and support tickets."
        },
        {
          "info": {
            "name": "SAP Commerce Cloud List customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.{region}.commercecloud.sap/InboundCustomer/Customers",
            "params": [
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "OData filter expression"
              },
              {
                "name": "$select",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of properties to return"
              },
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Number of results to skip"
              }
            ]
          },
          "docs": "Retrieve customer data through the inbound customer integration object."
        },
        {
          "info": {
            "name": "SAP Commerce Cloud Create or update a customer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenant}.{region}.commercecloud.sap/InboundCustomer/Customers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update customer data through the inbound integration layer."
        }
      ]
    }
  ],
  "bundled": true
}