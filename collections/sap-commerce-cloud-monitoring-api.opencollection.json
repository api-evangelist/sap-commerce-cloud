{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAP Commerce Cloud Admin Addresses Monitoring API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{tenant}.{region}.commercecloud.sap/authorizationserver/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Monitoring",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "SAP Commerce Cloud Get system metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.{region}.commercecloud.sap/monitoring/metrics"
          },
          "docs": "Retrieve system performance metrics including JVM stats, database connection pool, and request statistics."
        }
      ]
    }
  ],
  "bundled": true
}